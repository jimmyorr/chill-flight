# Android release keystore configuration
# Copy this file to android/keystore.properties (which is git-ignored) and fill in your password.

storeFile=~/.private_keys/chill-flight-2.jks
keyAlias=key0
storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEYSTORE_PASSWORD

# Optional: Google Play Developer API configuration for automated CLI publishing
# 1. Download Service Account JSON key from Google Cloud / Play Console (API access)
# 2. Save it to ~/.private_keys/chill-flight-play-service-account.json
# 3. Specify the path and track below:
serviceAccountJson=~/.private_keys/chill-flight-play-service-account.json
# Track options: internal (default, like TestFlight), alpha, beta, production
playTrack=internal

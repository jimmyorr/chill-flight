{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Chill Flight",
  "version": "../package.json",
  "identifier": "com.cowneck.chillflight",
  "build": {
    "frontendDist": "../docs",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Chill Flight",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset: tauri:",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' https://www.googletagmanager.com",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost blob: data: https://*.googletagmanager.com https://*.google-analytics.com https://*.google.com https://*.doubleclick.net",
        "font-src": "'self' data:",
        "media-src": "'self' asset: http://asset.localhost blob: data: https://pub-7309646d23c349d2894c38aad1291bf8.r2.dev",
        "connect-src": "'self' ipc: http://ipc.localhost ws: wss: http://localhost:* https://pub-7309646d23c349d2894c38aad1291bf8.r2.dev https://*.ingest.us.sentry.io https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.google.com https://*.doubleclick.net",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
